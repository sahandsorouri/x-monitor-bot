# Required: from BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Required: comma separated numeric Telegram user ids allowed to use the bot.
# Empty = the bot answers nobody.
ALLOWED_USER_IDS=

# Optional: X accounts to watch from the start, delivered to DIGEST_CHAT_ID.
# More can be added later with /add or by sending a handle to the bot.
# Example: WATCHED_ACCOUNTS=example_account,another_account
WATCHED_ACCOUNTS=
# Numeric chat id (a user, group or channel id, groups start with -100).
DIGEST_CHAT_ID=

# Optional: chat that gets an alert when every feed fetch fails for an hour.
ADMIN_CHAT_ID=

# Optional: contact shown in /help and /support.
SUPPORT_CONTACT=

# Optional: where config.json and seen_posts.json are kept (default: current folder).
# DATA_DIR=data
# Optional: health endpoint port (default 8080).
# HEALTH_PORT=8080
